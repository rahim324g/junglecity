{
  "buildCommand": "echo \"No build needed\"",
  "outputDirectory": "public_html",
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/$1.js" },
    { "src": "^/(.*)$", "dest": "/public_html/$1" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/public_html/index.html"
    }
  ]
}
